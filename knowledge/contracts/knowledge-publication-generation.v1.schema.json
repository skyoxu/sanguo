{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newrouge.knowledge-publication-generation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation_id", "authority_ref", "main_commit", "source_snapshot_id", "artifacts"],
  "properties": {
    "schema_version": {"const": "newrouge.knowledge-publication-generation.v1"},
    "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_ref": {"type": "string", "minLength": 1},
    "main_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_snapshot_id": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "catalog", "projections", "policies", "exclusions", "query_suite", "evaluation"],
      "properties": {
        "snapshot": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "catalog": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "projections": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "policies": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "exclusions": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "query_suite": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evaluation": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
