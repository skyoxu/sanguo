{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newrouge.knowledge-frozen-context.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "context_id", "consumer", "request_id", "freeze_state", "freeze_point",
    "snapshot", "policy_revision", "source_bundle_sha256", "decision_set_sha256",
    "required_context_classes", "satisfied_context_classes", "accepted_sources"
  ],
  "properties": {
    "schema_version": {"const": "newrouge.knowledge-frozen-context.v1"},
    "context_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "consumer": {"enum": ["repository-session", "chapter4", "chapter5", "chapter6", "review"]},
    "request_id": {"type": "string", "minLength": 1},
    "freeze_state": {"const": "frozen"},
    "freeze_point": {"type": "string", "minLength": 1},
    "snapshot": {
      "type": "object", "additionalProperties": false, "required": ["ref", "commit"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "policy_revision": {"const": "newrouge-knowledge-consumer-policies.v1"},
    "source_bundle_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision_set_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "required_context_classes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "satisfied_context_classes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "accepted_sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["module_id", "path", "source_sha256", "reason", "satisfies"],
        "properties": {
          "module_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
          "satisfies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
