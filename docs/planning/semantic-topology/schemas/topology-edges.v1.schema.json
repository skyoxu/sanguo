{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newrouge.topology-edges.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "newrouge.topology-edges.v1"
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "source_type",
          "source_id",
          "target_type",
          "target_id",
          "relation"
        ],
        "properties": {
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "target_type": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "evidence_level": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  }
}
