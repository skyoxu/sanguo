{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newrouge.capabilities.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "newrouge.capabilities.v1"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "capability_id",
          "title",
          "requirement_ids"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
