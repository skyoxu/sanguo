{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newrouge.semantic-requirements.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "newrouge.semantic-requirements.v1"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "requirement_id",
          "kind",
          "statement",
          "source_block_ids",
          "delivery_relevant",
          "sink_policy",
          "status"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "functional",
              "non_functional",
              "invariant",
              "failure",
              "scope",
              "metric",
              "constraint",
              "risk",
              "context",
              "rationale"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_block_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "delivery_relevant": {
            "type": "boolean"
          },
          "capability_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sink_policy": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string"
          }
        }
      }
    }
  }
}
