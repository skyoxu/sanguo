.gitattributes text eol=lf
* text=auto

# Source and project files (stable LF in repo)
*.cs        text diff=csharp eol=lf
*.csproj    text eol=lf
*.sln       text eol=lf
*.gd        text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.godot     text eol=lf
*.json      text eol=lf
*.jsonl     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.csv       text eol=lf
*.sql       text eol=lf
*.feature   text eol=lf
*.svg       text eol=lf
*.html      text eol=lf
*.css       text eol=lf

# Scripts
*.py        text eol=lf
*.sh        text eol=lf
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Godot metadata
*.import    text eol=lf
*.uid       text eol=lf
*.cfg       text eol=lf

# Binary files (no EOL conversion)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.bmp       binary
*.ico       binary
*.ogg       binary
*.wav       binary
*.mp3       binary
*.zip       binary
*.7z        binary
*.exe       binary
*.dll       binary
*.pdb       binary
*.pck       binary
*.scn       binary
